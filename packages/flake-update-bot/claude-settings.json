{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(fub:*)"
    ],
    "deny": [
      "Read(~/**)",
      "Read(//run/credentials/**)",
      "Read(//var/lib/flake-update-bot/claude/**)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "fub *"
    ],
    "filesystem": {
      "denyRead": [
        "~/",
        "//run/credentials",
        "//var/lib/flake-update-bot/claude"
      ]
    }
  }
}
